# better-auth declares an OPTIONAL peer on @tanstack/react-start, which in turn
# wants vite >= 7. This app uses Vitest 2 (vite 5) and does not use TanStack
# Start at all, but npm still tries to resolve that optional peer and fails.
# legacy-peer-deps keeps the install working without upgrading Vitest as a
# side effect. Revisit (and drop this file) if Vitest is ever moved to v5+,
# whose vite range (>= 6.4) overlaps again.
legacy-peer-deps=true
