# ---------------------------------------------------------------------------
# Client-side environment variables (baked into the JS bundle by Vite).
# Anything prefixed VITE_ is PUBLIC by design - never put server-only
# secrets here. See SECURITY.md.
# ---------------------------------------------------------------------------

# EmailJS credentials (https://dashboard.emailjs.com) - PUBLIC by design,
# identical to the inline init in the legacy HTML pages.
VITE_EMAILJS_SERVICE_ID=service_k2c0eve
VITE_EMAILJS_TEMPLATE_ID=template_kmxsnuc
VITE_EMAILJS_PUBLIC_KEY=2y064p5z9qRvVxOHN

# Optional overrides (defaults match the live production endpoints)
VITE_BOI_INTEREST_URL=https://www.boi.org.il/PublicApi/GetInterest
VITE_CBS_API_BASE=https://api.cbs.gov.il/index/data/price

# Set to "production" to enforce strict env validation at startup
NODE_ENV=development
