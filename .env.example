# ---------------------------------------------------------------------------
# Client-side environment variables (baked into the JS bundle by Vite).
# Anything prefixed VITE_ is PUBLIC by design - never put server-only
# secrets here. See SECURITY.md.
# ---------------------------------------------------------------------------

# EmailJS credentials (https://dashboard.emailjs.com) - PUBLIC by design,
# identical to the inline init in the legacy HTML pages.
VITE_EMAILJS_SERVICE_ID=service_k2c0eve
VITE_EMAILJS_TEMPLATE_ID=template_kmxsnuc
VITE_EMAILJS_PUBLIC_KEY=2y064p5z9qRvVxOHN

# Optional overrides (defaults match the live production endpoints)
VITE_BOI_INTEREST_URL=https://www.boi.org.il/PublicApi/GetInterest
VITE_CBS_API_BASE=https://api.cbs.gov.il/index/data/price

# Set to "production" to enforce strict env validation at startup
NODE_ENV=development

# ---------------------------------------------------------------------------
# Server-only variables (read by server/market/ via node --env-file; NEVER
# prefixed VITE_ - they must not reach the client bundle. See SECURITY.md.
# ---------------------------------------------------------------------------

# Finnhub market data (https://finnhub.io) - free tier: 60 calls/minute, no
# daily cap. Serves the ETFs (QQQ/SPY/EIS/GLD) and Bitcoin (BINANCE:BTCUSDT)
# via /quote. Forex needs a premium key, so USD/ILS comes from Frankfurter
# (api.frankfurter.dev, the ECB's keyless API) - nothing to configure for it.
FINNHUB_API_KEY=

# Market tracker tuning (defaults shown; values are milliseconds).
# Cache TTL: how long a fetched snapshot is reused before a refetch. 6h is
# plenty - both providers are effectively uncapped, this is just politeness.
MARKET_DATA_CACHE_TTL=21600000
# Client refresh interval (served to the UI via /api/market/quotes).
MARKET_DATA_REFRESH_INTERVAL=900000
