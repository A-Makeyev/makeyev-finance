[TEMPLATE]
# Environment for the Next app.
#
# CLIENT vars are PUBLIC by design: the clean (non-prefixed) names are inlined
# into the browser bundle via the `env` block in next.config.ts, and
# NEXT_PUBLIC_* is also accepted and preferred if present. Server-only secrets
# must never be prefixed and must never be imported by client code.

# External data endpoints (defaults exist; override only if the endpoints move)
# BOI_INTEREST_URL=https://www.boi.org.il/PublicApi/GetInterest
# CBS_API_BASE=https://api.cbs.gov.il/index/data/price

# --- Server-only (never exposed to the client bundle) ---------------------
# Finnhub market data (https://finnhub.io). Free tier: 60 calls/minute, no
# daily cap. Serves the ETFs (SPY/QQQ) and Bitcoin via /quote. Forex, index
# and commodity levels need a premium key, so USD/ILS comes from Frankfurter
# (keyless) and TA-35 + COMEX gold from Yahoo (keyless). Without a key the
# quotes endpoint degrades to 503 and the Markets strip hides itself.
FINNHUB_API_KEY=

# Optional cache/refresh tuning (defaults documented in src/server/market/config.ts)
# MARKET_DATA_CACHE_TTL=900000
# MARKET_DATA_FINNHUB_CACHE_TTL=10000
# MARKET_DATA_YAHOO_REALTIME_CACHE_TTL=15000
# MARKET_DATA_YAHOO_CACHE_TTL=900000
# MARKET_DATA_REFRESH_INTERVAL=10000

# --- Auth (Better Auth + MongoDB) -----------------------------------------
# All server-only. Never prefix any of these with NEXT_PUBLIC_.

# Mongo connection string, INCLUDING the database name (e.g. /dev locally).
# Required at runtime; a missing value breaks auth requests, not the build.
MONGODB_URI=

# Signing secret. Better Auth REFUSES to start in production without one, so
# this is required for `npm start` and on Render (dev auto-generates one).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# --- Mail (Resend), all server-only ---------------------------------------
# Resend's API is called from the server only, so the browser never holds the
# key. Never prefix any of these with NEXT_PUBLIC_.

# API key (https://resend.com/api-keys). The ONLY required mail variable:
# missing = mail is disabled and the email-verification requirement is relaxed.
RESEND_API_KEY=

# From address for every outgoing mail. Leave it unset and the app uses Resend's
# own test sender, `Makeyev Finance <onboarding@resend.dev>`, which sends with no
# setup at all but delivers ONLY to the Resend account owner's address.
#
# For real delivery, set this to an address on a domain you verified at
# https://resend.com/domains. Resend refuses to send from an unverified domain,
# and a consumer domain (gmail.com, outlook.com, ...) can NEVER be verified: a
# Gmail address here makes EVERY send fail with `validation_error` (HTTP 403) ~
# verification mail, password resets and the contact form alike. A bare address
# is fine ('Makeyev Finance' becomes its display name).
# AUTH_EMAIL_FROM="Makeyev Finance <no-reply@makeyev-finance.com>"
#
# Where contact-form submissions are delivered. Defaults to the address the site
# already publishes (SITE.emailMain in src/config/siteConfig.ts), which is also
# the Resend account owner's address on this account ~ the only address the test
# sender can deliver to. Set it to route them somewhere else.
# CONTACT_TO_EMAIL=

# Ask these three variables what they think with: npm run mail:doctor

# --- Social sign-in (optional, all server-only) ---------------------------
# Google is the only social provider: it is enabled by setting BOTH of its
# vars; a missing var means the provider is not registered with Better Auth
# and its button does not appear on the login page. The ENABLED list is
# derived and exposed to the client as AUTH_SOCIAL_PROVIDERS (comma-joined,
# see next.config.ts) - never set that var by hand and never expose the id or
# secret itself.
#
# Google (https://console.cloud.google.com/apis/credentials): authorized
# JavaScript origin = your origin, redirect URI = <origin>/api/auth/callback/google.
# The redirect URI is derived by Better Auth from the request origin - there
# is no GOOGLE_REDIRECT_URI var; just register that same URI in the Google
# console for each origin you deploy to.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
